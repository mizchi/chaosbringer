{
  "name": "@mizchi/chaosbringer-example-cloudflare-worker",
  "private": true,
  "type": "module",
  "description": "Hono on Cloudflare Worker + @mizchi/server-faults + chaosbringer (remote mode)",
  "scripts": {
    "dev": "wrangler dev",
    "chaos": "tsx chaos/run.ts",
    "model": "chaosbringer model run --plans model/plans --url ${BASE_URL:-http://localhost:8787} --config model/bridge.mjs",
    "model:enumerate": "model/enumerate.sh",
    "model:compile": "chaosbringer model compile --traces model/traces --out model/plans",
    "typecheck": "tsc --noEmit",
    "test": "node test.mjs"
  },
  "dependencies": {
    "@mizchi/server-faults": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "chaosbringer": "workspace:*",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
