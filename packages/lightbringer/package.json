{
  "name": "lightbringer",
  "version": "0.5.0",
  "description": "Per-step web performance measurement for Playwright: network / CPU / render / INP / memory / coverage at initialization and between steps. Use the test fixture, or the zero-config CLI that runs a JSON scenario and emits budgets. Median regression gate and trace drilldown.",
  "type": "module",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/chaosbringer.git",
    "directory": "packages/lightbringer"
  },
  "homepage": "https://github.com/mizchi/chaosbringer/tree/main/packages/lightbringer#readme",
  "bugs": {
    "url": "https://github.com/mizchi/chaosbringer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "performance",
    "web-vitals",
    "cdp",
    "tracing"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "default": "./dist/fixture.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./analyze": {
      "types": "./dist/analyze/index.d.ts",
      "default": "./dist/analyze/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "bin": {
    "lightbringer": "dist/cli.js",
    "lightbringer-median": "scripts/median.mjs",
    "lightbringer-drilldown": "scripts/drilldown.mjs",
    "lightbringer-regress": "scripts/regress.mjs",
    "lightbringer-coverage": "scripts/coverage.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:bundle": "playwright test -c playwright.bundle.config.ts",
    "bundle:gen": "node fixtures/bundle/gen-image.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "median": "node scripts/median.mjs",
    "drilldown": "node scripts/drilldown.mjs",
    "regress": "node scripts/regress.mjs",
    "coverage": "node scripts/coverage.mjs",
    "lint:nul": "node ../chaosbringer/scripts/check-no-nul.mjs src scripts examples fixtures"
  },
  "dependencies": {
    "playwright": "^1.59.0",
    "web-vitals": "^6.2.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mizchi/playwright-faults": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
